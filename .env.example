# Jarvis configuration example.
# Real values live in config/api_keys.json, which is gitignored. Nothing in
# this file is a secret — it documents what has to be set, not what it is set to.

# ── Phone calling ────────────────────────────────────────────────────────────
# Calls go out over your own iPhone on your own SIM, via Continuity. Jarvis
# does not originate the call and cannot set the caller ID: the SIM does that,
# which is exactly why the recipient sees your real number with nothing to
# verify and no per-minute cost beyond your existing plan.
#
# Requires, one time:
#   1. iPhone: Settings > Cellular > Calls on Other Devices > Allow, and this
#      Mac enabled. Same Apple ID, same Wi-Fi.
#   2. An audio interface bridging the phone and this Mac:
#        Mac output      -> iPhone microphone input   (Jarvis is heard)
#        iPhone earpiece  -> Mac input                (Jarvis hears)
#      Without it Jarvis can dial, but you do the talking.

CALLING_ENABLED=false
# Your number, in international form. Display only — Jarvis says which number
# it is calling from; it cannot change it.
CALLER_ID=+000000000000
# Ask before dialling. Leave on: a misheard name otherwise rings a real person.
CONFIRM_BEFORE_CALL=true
# Names as they appear in the system audio device list.
CALL_BRIDGE_INPUT=
CALL_BRIDGE_OUTPUT=
# Used in the spoken introduction: "calling on behalf of ...".
OWNER_NAME=

# ── Hermes agent ─────────────────────────────────────────────────────────────
# Runs on the Gemini keys already configured; needs no separate provider.
HERMES_TURNS_PER_CALL=12
HERMES_CALLS_PER_HOUR=6
HERMES_CALLS_PER_DAY=30

# ── Keys (set these in config/api_keys.json, never here) ─────────────────────
GEMINI_API_KEY=
FAL_KEY=
SKETCHFAB_TOKEN=

# ── Contacts ─────────────────────────────────────────────────────────────────
# Phone numbers live in config/contacts.json, which is gitignored. Never put a
# real number in source or in this file.
#   { "Mama": "+966XXXXXXXXX", "Baba": "+966XXXXXXXXX" }
